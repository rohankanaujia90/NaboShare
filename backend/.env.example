APP_NAME=NaboShare API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://naboshare:naboshare_local_password@localhost:5432/naboshare
DATABASE_CONNECT_TIMEOUT_SECONDS=5
CORS_ORIGINS=["http://localhost:5173"]

# Generate a strong value before implementing JWT authentication.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=naboshare-api
JWT_AUDIENCE=naboshare-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
